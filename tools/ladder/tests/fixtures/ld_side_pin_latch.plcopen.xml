<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-authored for review item 4.1: a box wired into another box's side pin.

  An SR latch drives the RESET pin of a counter, with no negation anywhere -
  the plainest form of the shape. Everything to the left of the latch is the
  latch's own input, so the counter's RESET pin reads "latch.Q1" and nothing
  else; folding the chain into the caption ("xSet AND latch.Q1") states a
  condition the program does not have, and leaves the latch never called.
-->
<project xmlns="http://www.plcopen.org/xml/tc6_0201">
  <fileHeader companyName="greenforge-labs" productName="codescribe-fixture" productVersion="1"
              creationDateTime="2020-01-01T00:00:00"/>
  <contentHeader name="LadderSidePinFixture">
    <coordinateInfo>
      <fbd><scaling x="1" y="1"/></fbd>
      <ld><scaling x="1" y="1"/></ld>
      <sfc><scaling x="1" y="1"/></sfc>
    </coordinateInfo>
  </contentHeader>
  <types>
    <dataTypes/>
    <pous>
      <pou name="LD_SIDE_PIN" pouType="program">
        <interface>
          <localVars>
            <variable name="xSet">
              <type><BOOL/></type>
            </variable>
            <variable name="xClear">
              <type><BOOL/></type>
            </variable>
            <variable name="xCount">
              <type><BOOL/></type>
            </variable>
            <variable name="xDone">
              <type><BOOL/></type>
            </variable>
            <variable name="latch">
              <type><derived name="SR"/></type>
            </variable>
            <variable name="ctr">
              <type><derived name="CTU"/></type>
            </variable>
          </localVars>
        </interface>
        <body>
          <LD>
            <!-- Network 1: latch.Q1 into ctr's RESET pin -->
            <leftPowerRail localId="1">
              <position x="10" y="10"/>
              <connectionPointOut><relPosition x="0" y="10"/></connectionPointOut>
            </leftPowerRail>
            <contact localId="2" negated="false">
              <position x="40" y="40"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut><relPosition x="30" y="10"/></connectionPointOut>
              <variable>xSet</variable>
            </contact>
            <inVariable localId="3">
              <position x="40" y="60"/>
              <connectionPointOut><relPosition x="30" y="10"/></connectionPointOut>
              <expression>xClear</expression>
            </inVariable>
            <block localId="4" typeName="SR" instanceName="latch">
              <position x="90" y="40"/>
              <inputVariables>
                <variable formalParameter="SET1">
                  <connectionPointIn>
                    <relPosition x="0" y="10"/>
                    <connection refLocalId="2"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="RESET">
                  <connectionPointIn>
                    <relPosition x="0" y="20"/>
                    <connection refLocalId="3"/>
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q1">
                  <connectionPointOut><relPosition x="40" y="10"/></connectionPointOut>
                </variable>
              </outputVariables>
            </block>
            <contact localId="5" negated="false">
              <position x="40" y="10"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="1"/>
              </connectionPointIn>
              <connectionPointOut><relPosition x="30" y="10"/></connectionPointOut>
              <variable>xCount</variable>
            </contact>
            <block localId="6" typeName="CTU" instanceName="ctr">
              <position x="150" y="10"/>
              <inputVariables>
                <variable formalParameter="CU">
                  <connectionPointIn>
                    <relPosition x="0" y="10"/>
                    <connection refLocalId="5"/>
                  </connectionPointIn>
                </variable>
                <variable formalParameter="RESET">
                  <connectionPointIn>
                    <relPosition x="0" y="20"/>
                    <connection refLocalId="4" formalParameter="Q1"/>
                  </connectionPointIn>
                </variable>
              </inputVariables>
              <inOutVariables/>
              <outputVariables>
                <variable formalParameter="Q">
                  <connectionPointOut><relPosition x="40" y="10"/></connectionPointOut>
                </variable>
              </outputVariables>
            </block>
            <coil localId="7" negated="false">
              <position x="210" y="10"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="6" formalParameter="Q"/>
              </connectionPointIn>
              <connectionPointOut><relPosition x="30" y="10"/></connectionPointOut>
              <variable>xDone</variable>
            </coil>
            <rightPowerRail localId="8">
              <position x="250" y="10"/>
              <connectionPointIn>
                <relPosition x="0" y="10"/>
                <connection refLocalId="7"/>
              </connectionPointIn>
            </rightPowerRail>
          </LD>
        </body>
      </pou>
    </pous>
  </types>
  <instances><configurations/></instances>
</project>
